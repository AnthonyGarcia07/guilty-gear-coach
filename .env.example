ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/guilty_gear_coach
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=guilty-gear-coach-replays
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
S3_PRESIGNED_UPLOAD_EXPIRATION_SECONDS=900
S3_PRESIGNED_DOWNLOAD_EXPIRATION_SECONDS=300
MAX_MP4_UPLOAD_SIZE_BYTES=2147483648
